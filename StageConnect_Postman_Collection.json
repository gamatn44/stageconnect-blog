{
  "info": {
    "name": "StageConnect - Matching & Recommendation (Port 3004)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Matching - CRUD & Métiers",
      "item": [
        {
          "name": "POST Match + Recommandation Auto (>= 70%)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:3004/api/matchings", "protocol": "http", "host": ["localhost"], "port": "3004", "path": ["api", "matchings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"etudiant\": {\n    \"id\": \"etu_chaima\",\n    \"typeStage\": \"PFE\",\n    \"competences\": [\"Node.js\", \"MongoDB\", \"Express\"],\n    \"isBoosted\": true\n  },\n  \"offre\": {\n    \"id\": \"off_pfe_2026\",\n    \"typeStageObligatoire\": \"PFE\",\n    \"competencesRequises\": [\"Node.js\", \"MongoDB\", \"Express\", \"Docker\"],\n    \"isUrgent\": false\n  }\n}"
            }
          }
        },
        {
          "name": "POST Match - Critère Éliminatoire (Score 0)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "http://localhost:3004/api/matchings", "protocol": "http", "host": ["localhost"], "port": "3004", "path": ["api", "matchings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"etudiant\": {\n    \"id\": \"etu_chaima\",\n    \"typeStage\": \"Initiation\",\n    \"competences\": [\"Node.js\", \"MongoDB\"]\n  },\n  \"offre\": {\n    \"id\": \"off_pfe_strict\",\n    \"typeStageObligatoire\": \"PFE\",\n    \"competencesRequises\": [\"Node.js\", \"MongoDB\"]\n  }\n}"
            }
          }
        },
        {
          "name": "GET Tous les Matchings (Triés par score)",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3004/api/matchings?etudiantId=etu_chaima", "protocol": "http", "host": ["localhost"], "port": "3004", "path": ["api", "matchings"], "query": [{ "key": "etudiantId", "value": "etu_chaima" }] }
          }
        },
        {
          "name": "GET Statistiques Matchings",
          "request": {
            "method": "GET",
