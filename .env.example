# --- JWT ---
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=1h

# --- Envoi d'emails (Gmail) ---
# MAIL_USER vide = mode développement : aucun mail envoyé, le lien est affiché dans la console.
# Pour Gmail : activer la validation en 2 étapes puis créer un "mot de passe d'application"
# (https://myaccount.google.com/apppasswords) et le mettre dans MAIL_PASSWORD.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
# Optionnel. Par défaut : StageConnect <MAIL_USER>
MAIL_FROM=
APP_URL=http://localhost:3000

# --- Compte administrateur créé par : npm run seed:admin ---
ADMIN_EMAIL=admin@stageconnect.tn
ADMIN_PASSWORD=

# --- Archivage Discord des événements de sécurité ---
# Vide = rien envoyé, un log est affiché dans la console. Créer un webhook : Paramètres du salon > Intégrations > Webhooks.
# Ne jamais partager cette URL (elle donne le droit de poster dans le salon).
DISCORD_WEBHOOK_URL=
