                "historiques"
              ]
            },
            "description": "Résultat attendu : 404, utilisateur introuvable (l'identifiant est valide mais ne correspond à aucun compte).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"6af5e30b455470d368f99999\",\n  \"action\": \"CONNEXION\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "14. Historique par id (200, user peuplé)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/historiques/{{historiqueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "historiques",
                "{{historiqueId}}"
              ]
            },
            "description": "Résultat attendu : 200, le champ `user` contient nom, prenom, email et role (populate)."
          },
          "response": []
        },
        {
          "name": "15. Modifier une entrée (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/historiques/{{historiqueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "historiques",
                "{{historiqueId}}"
              ]
            },
            "description": "Résultat attendu : 200, description mise à jour.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Description modifiée\"\n}",
              "options": {
                "raw": {
                  "language": "json"
