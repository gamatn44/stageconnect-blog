                "historiques",
                "{{historiqueId}}"
              ]
            },
            "description": "Résultat attendu : 200, entrée supprimée."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Acte 4",
      "description": "Métiers simples : recherche, filtres, tri, pagination, statistiques",
      "item": [
        {
          "name": "17. Recherche (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?search=sami",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "sami"
                }
              ]
            },
            "description": "Résultat attendu : 200, les utilisateurs dont le nom, le prénom ou l'email contient « sami » (insensible à la casse)."
          },
          "response": []
        },
        {
          "name": "18. Filtres, tri et pagination (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?role=etudiant&statut=inactif&sort=nom&order=asc&page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "etudiant"
                },
                {
                  "key": "statut",
                  "value": "inactif"
                },
                {
                  "key": "sort",
                  "value": "nom"
                },
                {
                  "key": "order",
                  "value": "asc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Résultat attendu : 200, utilisateurs étudiants inactifs triés par nom croissant, avec `pagination` (limit 5)."
          },
          "response": []
        },
        {
          "name": "19. Filtre invalide (400 valeurs autorisées)",
          "request": {
            "method": "GET",
