            "description": "Résultat attendu : 400, rôle invalide : seuls `etudiant` et `entreprise` sont autorisés à l'inscription.\n\nPhrase à dire : « On ne peut pas s'auto-attribuer le rôle administrateur. »",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Pirate\",\n  \"prenom\": \"Test\",\n  \"email\": \"pirate@test.tn\",\n  \"motDePasse\": \"Pirate2026!\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
