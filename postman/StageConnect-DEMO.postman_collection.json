            "description": "Résultat attendu : 400, erreur de validation : l'action doit appartenir à la liste autorisée.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"{{userId}}\",\n  \"action\": \"PIRATAGE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "13. Utilisateur inexistant (404 utilisateur introuvable)",
          "request": {
            "method": "POST",
            "header": [
