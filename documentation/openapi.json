          "404": {
            "description": "Auteur introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "message": "auteur introuvable"
                }
              }
            }
          }
        }
      }
    },
    "/ia/reformuler": {
      "post": {
        "tags": [
          "Intelligence artificielle"
        ],
        "summary": "Reformuler un texte (Gemini)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "texte"
                ],
                "properties": {
                  "texte": {
                    "type": "string"
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "professionnel",
                      "simple",
                      "court",
                      "corriger"
                    ],
                    "default": "professionnel"
                  }
                }
              },
              "example": {
                "texte": "salut tout le monde jai fait mon stage chez une startup c etait trop bien",
                "style": "professionnel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Texte reformulé",
            "content": {
              "application/json": {
                "example": {
                  "style": "professionnel",
                  "original": "...",
                  "reformulation": "..."
                }
              }
            }
          },
          "400": {
            "description": "Texte manquant ou style inconnu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          }
        }
      }
    },
    "/ia/question/{idblog}": {
      "post": {
        "tags": [
          "Intelligence artificielle"
        ],
        "summary": "Poser une question sous un blog",
        "description": "L'IA répond à partir de l'article et des 10 derniers commentaires. Passe par le middleware de modération.",
        "parameters": [
          {
            "name": "idblog",
            "in": "path",
            "required": true,
            "description": "Id du blog",
            "schema": {
              "type": "string"
            },
            "example": "6af5e1030d75e17a81abd65c"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "question",
                  "auteur",
                  "email"
                ],
                "properties": {
                  "question": {
                    "type": "string"
                  },
                  "auteur": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "question": "Combien de questions faut-il préparer pour le recruteur ?",
                "auteur": "Mohamed Amine Allouche",
                "email": "amine.allouche@example.com"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Question et réponse enregistrées",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Question"
                }
              }
            }
          },
          "400": {
            "description": "Contenu refusé par la modération",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Moderation"
                },
                "example": {
                  "message": "contenu refusé par la modération",
                  "champ": "contenu",
                  "motInterdit": "ca ya dawla"
                }
              }
            }
          },
          "404": {
            "description": "Blog introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "message": "blog introuvable"
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          }
        }
      }
    },
    "/ia/questions/{idblog}": {
      "get": {
        "tags": [
          "Intelligence artificielle"
        ],
        "summary": "Questions-réponses d'un blog",
        "parameters": [
          {
            "name": "idblog",
            "in": "path",
            "required": true,
            "description": "Id du blog",
            "schema": {
              "type": "string"
            },
            "example": "6af5e1030d75e17a81abd65c"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resultats": {
                      "type": "integer"
                    },
                    "questions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Question"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
