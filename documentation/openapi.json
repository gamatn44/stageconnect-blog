{
  "openapi": "3.0.3",
  "info": {
    "title": "StageConnect – Service Blog",
    "version": "1.0.0",
    "description": "API du microservice Blog : CRUD des blogs et commentaires, recherche, modération, statistiques, tendances, badges d'auteur, traduction et assistant IA."
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Local"
    }
  ],
  "tags": [
    {
      "name": "Blogs"
    },
    {
      "name": "Commentaires"
    },
    {
      "name": "Statistiques et tendances"
    },
    {
      "name": "Auteurs et badges"
    },
    {
      "name": "Traduction"
    },
    {
      "name": "Intelligence artificielle"
    }
  ],
  "paths": {
    "/blog/addblog": {
      "post": {
        "tags": [
          "Blogs"
        ],
        "summary": "Créer un blog",
        "description": "Passe par le middleware de modération.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlogInput"
              },
              "example": {
                "titre": "Réussir son entretien de stage",
                "contenu": "Voici 5 conseils pour préparer votre entretien...",
                "auteur": "Mohamed Amine Allouche",
                "email": "amine.allouche@example.com",
                "categorie": "Conseils"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Blog créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blog"
                }
              }
            }
          },
          "400": {
            "description": "Contenu refusé par la modération",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Moderation"
                },
                "example": {
                  "message": "contenu refusé par la modération",
                  "champ": "contenu",
                  "motInterdit": "ca ya dawla"
                }
              }
            }
          }
        }
      }
    },
    "/blog/showallblog": {
      "get": {
        "tags": [
          "Blogs"
        ],
        "summary": "Afficher tous les blogs (du plus récent au plus ancien)",
        "responses": {
          "200": {
            "description": "Liste des blogs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Blog"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          }
        }
      }
    },
    "/blog/showblog/{id}": {
      "get": {
        "tags": [
          "Blogs"
        ],
        "summary": "Afficher un blog",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id du blog",
            "schema": {
              "type": "string"
            },
            "example": "6af5e1030d75e17a81abd65c"
          }
        ],
        "responses": {
          "200": {
            "description": "Le blog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blog"
                }
              }
            }
          },
          "404": {
            "description": "Blog introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "message": "blog introuvable"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "message": "..."
                }
              }
            }
          }
        }
      }
    },
    "/blog/updateblog/{id}": {
      "put": {
        "tags": [
          "Blogs"
        ],
        "summary": "Modifier un blog",
        "description": "Passe par le middleware de modération.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id du blog",
            "schema": {
              "type": "string"
            },
            "example": "6af5e1030d75e17a81abd65c"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlogInput"
              },
              "example": {
                "titre": "Réussir son entretien de stage (mis à jour)"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Blog modifié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blog"
                }
              }
            }
          },
          "400": {
            "description": "Contenu refusé par la modération",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Moderation"
                },
                "example": {
                  "message": "contenu refusé par la modération",
                  "champ": "contenu",
                  "motInterdit": "ca ya dawla"
                }
              }
            }
          },
          "404": {
            "description": "Blog introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "message": "blog introuvable"
                }
              }
            }
          }
        }
      }
    },
    "/blog/deleteblog/{id}": {
      "delete": {
        "tags": [
          "Blogs"
        ],
        "summary": "Supprimer un blog (et ses commentaires et questions)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id du blog",
            "schema": {
              "type": "string"
            },
            "example": "6af5e1030d75e17a81abd65c"
          }
        ],
        "responses": {
          "200": {
            "description": "Supprimé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                },
                "example": {
                  "message": "blog, commentaires et questions supprimés"
                }
              }
            }
          },
          "404": {
            "description": "Blog introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "message": "blog introuvable"
                }
              }
            }
          }
        }
      }
    },
    "/blog/likeblog/{id}": {
      "put": {
        "tags": [
          "Blogs"
        ],
        "summary": "Liker un blog (+1)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id du blog",
            "schema": {
              "type": "string"
            },
            "example": "6af5e1030d75e17a81abd65c"
          }
        ],
        "responses": {
          "200": {
            "description": "Blog avec le nouveau nombre de likes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blog"
                }
              }
            }
          },
          "404": {
            "description": "Blog introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "message": "blog introuvable"
                }
              }
            }
          }
        }
      }
    },
    "/blog/search": {
      "get": {
        "tags": [
          "Blogs"
        ],
        "summary": "Recherche, filtres et tri",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Mot cherché dans le titre ou le contenu",
            "schema": {
              "type": "string"
            },
            "example": "CV"
          },
          {
            "name": "categorie",
            "in": "query",
            "required": false,
            "description": "Catégorie exacte",
            "schema": {
              "type": "string"
            },
            "example": "Conseils"
          },
          {
            "name": "auteur",
            "in": "query",
            "required": false,
            "description": "Partie du nom de l'auteur",
            "schema": {
              "type": "string"
            },
            "example": "sarra"
          },
          {
            "name": "minLikes",
            "in": "query",
            "required": false,
            "description": "Nombre minimum de likes",
            "schema": {
              "type": "integer"
            },
            "example": 20
          },
          {
            "name": "depuis",
            "in": "query",
            "required": false,
            "description": "Blogs publiés depuis X jours",
            "schema": {
              "type": "integer"
            },
            "example": 7
          },
          {
            "name": "tri",
            "in": "query",
            "required": false,
            "description": "Ordre des résultats",
            "schema": {
              "type": "string",
              "enum": [
                "recent",
                "ancien",
                "populaire"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Résultats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resultats": {
                      "type": "integer"
                    },
                    "blogs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Blog"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/blog/traduire/{id}": {
      "get": {
        "tags": [
          "Traduction"
        ],
        "summary": "Traduire un blog (API MyMemory)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id du blog",
            "schema": {
              "type": "string"
            },
            "example": "6af5e1030d75e17a81abd65c"
          },
          {
            "name": "langue",
            "in": "query",
            "required": false,
            "description": "Langue cible",
            "schema": {
              "type": "string",
              "enum": [
                "fr",
                "en",
                "ar",
                "es",
                "de",
                "it"
              ]
            },
            "example": "en"
          }
        ],
        "responses": {
          "200": {
            "description": "Original et traduction",
            "content": {
              "application/json": {
                "example": {
                  "_id": "6af5e1030d75e17a81abd65c",
                  "langue": "en",
                  "original": {
                    "titre": "...",
                    "contenu": "..."
                  },
                  "traduction": {
                    "titre": "...",
                    "contenu": "..."
                  }
                }
              }
            }
          },
          "400": {
            "description": "Langue non disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          },
          "404": {
            "description": "Blog introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "message": "blog introuvable"
                }
              }
            }
          }
        }
      }
    },
    "/commentaire/addcommentaire": {
      "post": {
        "tags": [
          "Commentaires"
        ],
        "summary": "Ajouter un commentaire",
        "description": "Vérifie que le blog existe. Passe par le middleware de modération.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentaireInput"
              },
              "example": {
                "contenu": "Merci, ces conseils sont très utiles !",
                "auteur": "Mohamed Amine Allouche",
                "email": "amine.allouche@example.com",
                "blog": "6af5e1030d75e17a81abd65c"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Commentaire créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Commentaire"
                }
              }
            }
          },
          "400": {
            "description": "Contenu refusé par la modération",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Moderation"
                },
                "example": {
                  "message": "contenu refusé par la modération",
                  "champ": "contenu",
                  "motInterdit": "ca ya dawla"
                }
              }
            }
          },
          "404": {
            "description": "Blog introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "message": "blog introuvable"
                }
              }
            }
          }
        }
      }
    },
    "/commentaire/showallcommentaire": {
      "get": {
        "tags": [
          "Commentaires"
        ],
        "summary": "Afficher tous les commentaires (avec le titre du blog)",
