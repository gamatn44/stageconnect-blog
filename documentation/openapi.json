    "/stats": {
      "get": {
        "tags": [
          "Statistiques et tendances"
        ],
        "summary": "Statistiques globales",
        "description": "Totaux, moyennes, répartition par catégorie, top blogs, top auteurs, activité sur 7 jours (agrégations MongoDB).",
        "responses": {
          "200": {
            "description": "Statistiques"
          }
        }
      }
    },
    "/tendances/blogs": {
      "get": {
        "tags": [
          "Statistiques et tendances"
        ],
        "summary": "Blogs en tendance",
        "description": "score = (likes + 3 × commentaires récents) / (âge en jours + 2)^1.5",
        "parameters": [
          {
            "name": "jours",
            "in": "query",
            "required": false,
            "description": "Période en jours (défaut 7)",
            "schema": {
              "type": "integer"
            },
            "example": 7
          }
        ],
        "responses": {
          "200": {
            "description": "Top 5 des blogs"
          }
        }
      }
    },
    "/tendances/categories": {
      "get": {
        "tags": [
          "Statistiques et tendances"
        ],
        "summary": "Catégories en tendance",
        "parameters": [
          {
            "name": "jours",
            "in": "query",
            "required": false,
            "description": "Période en jours (défaut 7)",
            "schema": {
              "type": "integer"
            },
            "example": 7
          }
        ],
        "responses": {
          "200": {
            "description": "Catégories classées par commentaires récents"
          }
        }
      }
    },
    "/tendances/mots": {
      "get": {
        "tags": [
