              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cvs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "nom"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            }
          }
        },
